# LLM provider: Google AI Studio (Gemini, OpenAI-compatible endpoint)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# GitHub API (fine-grained PAT: Contents:read, Issues:read for tools)
GITHUB_TOKEN=""

# Demo target repo the agent investigates (owner/name)
DEMO_REPO="Jibril1001/test_repo"

# Web search: ddgs (default, no key) or tavily (needs key)
WEB_SEARCH_PROVIDER="ddgs"
TAVILY_API_KEY=""

# Server paths
DB_PATH="data/incidents.db"
REPORTS_DIR="reports"

# Scoped bearer tokens (HTTP transport - stretch goal)
MCP_TOKEN_ADMIN=""
MCP_TOKEN_READONLY=""
