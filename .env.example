# LLM provider: groq (default) or gemini
LLM_PROVIDER="groq"

# Groq (https://console.groq.com) - free tier allows ~1,000 requests/day.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MAX_TOKENS="2048"

# Google Gemini (used when LLM_PROVIDER=gemini). Free tier is 20 requests/day
# per model. Use GEMINI_API_KEY, or GOOGLE_API_KEY (both are accepted).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MAX_TOKENS="8192"
GEMINI_REASONING_EFFORT="low"

# GitHub API (fine-grained PAT: Contents:read, Issues:read for tools)
GITHUB_TOKEN=""

# Demo target repo the agent investigates (owner/name)
DEMO_REPO="Jibril1001/test_repo"

# Web search: ddgs (default, no key) or tavily (needs key)
WEB_SEARCH_PROVIDER="ddgs"
TAVILY_API_KEY=""

# Server paths
DB_PATH="data/incidents.db"
REPORTS_DIR="reports"

# --- Streamable HTTP transport (optional) ---
# Public URL the server is reachable at (used for auth metadata).
MCP_PUBLIC_URL="http://127.0.0.1:8000"

# Scoped bearer tokens. Generate long random values, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# admin has all scopes; readonly is blocked from report:write.
MCP_TOKEN_ADMIN=""
MCP_TOKEN_READONLY=""

# Client token used by `python -m client.agent --transport http`.
MCP_TOKEN=""
MCP_URL="http://127.0.0.1:8000/mcp"
