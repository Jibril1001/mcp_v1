# LLM provider: Google AI Studio (Gemini, OpenAI-compatible endpoint)
# Use GEMINI_API_KEY, or GOOGLE_API_KEY (both are accepted).
GEMINI_API_KEY=""
# gemini-2.5-flash-lite: faster/cheaper; the free tier is still 20 requests
# per day per model, so a full investigation (~5-6 calls) uses most of it.
GEMINI_MODEL="gemini-2.5-flash-lite"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MAX_TOKENS="8192"
GEMINI_REASONING_EFFORT="low"

# GitHub API (fine-grained PAT: Contents:read, Issues:read for tools)
GITHUB_TOKEN=""

# Demo target repo the agent investigates (owner/name)
DEMO_REPO="Jibril1001/test_repo"

# Web search: ddgs (default, no key) or tavily (needs key)
WEB_SEARCH_PROVIDER="ddgs"
TAVILY_API_KEY=""

# Server paths
DB_PATH="data/incidents.db"
REPORTS_DIR="reports"

# Scoped bearer tokens (HTTP transport - stretch goal)
MCP_TOKEN_ADMIN=""
MCP_TOKEN_READONLY=""
